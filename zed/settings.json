// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
//
// 本文件由 dotfiles 仓库管理。模型 provider、默认模型和 SSH 连接是本机配置，
// 放在 ~/.config/zed/global_settings.json（language_models、agent.default_model、
// ssh_connections）。在 Zed 里切换模型或添加 SSH 服务器会把这些字段写回本文件，
// 提交前需移回 global_settings.json。
{
  "debugger": {
    "button": false
  },
  "outline_panel": {
    "button": false
  },
  "collaboration_panel": {
    "button": false
  },
  "disable_ai": false,
  "minimap": {
    "show": "always"
  },
  "project_panel": {
    "dock": "left"
  },
  "base_keymap": "VSCode",
  // 新机器自动安装的扩展（html 由 Zed 默认安装）
  "auto_install_extensions": {
    "log": true
  },
  "lsp": {
    "basedpyright": {
      "settings": {
        "basedpyright": {
          "analysis": {
            "typeCheckingMode": "basic",
            "diagnosticMode": "openFilesOnly"
          }
        }
      }
    },
    "ruff": {
      "initialization_options": {
        "settings": {
          "lint": {
            "enable": false
          }
        }
      }
    }
  },
  "agent": {
    "dock": "right",
    "default_profile": "ask"
  },
  "icon_theme": "Zed (Default)",
  "ui_font_size": 18,
  "buffer_font_family": "Menlo",
  "buffer_font_size": 18,
  "agent_buffer_font_size": 18,
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light",
    "dark": "Gruvbox Deep Dark",
  },
}
